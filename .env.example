# Do not replace your production .env with this example.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ENGINE_DATABASE
DB_USER=ENGINE_DB_USER
DB_PASSWORD=ENGINE_DB_PASSWORD
FRESH_ENGINE_API_KEYS=fai_EXISTING_ENGINE_KEYS_COMMA_SEPARATED
FRESH_CHAT_ENGINE_KEY=fai_CREATE_A_SEPARATE_RANDOM_CHAT_ONLY_KEY
FRESH_CHAT_REPORTING_SECRET=GENERATE_ANOTHER_UNIQUE_RANDOM_32_PLUS_CHAR_SECRET
FRESH_CHAT_URL=https://chat.freshcrackers.cz
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
CUSTOMER_SESSION_SECRET=CHANGE_ME_RANDOM_32_CHARACTERS_MINIMUM

# Fresh Account on freshcrackers.cz. Keep the app-specific ai-engine secret here.
# Do NOT reuse the Chat secret.
FRESH_ACCOUNT_URL=https://www.freshcrackers.cz
FRESH_ACCOUNT_APP_ID=ai-engine
FRESH_ACCOUNT_SECRET=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
STORE_PAYLOADS=false
ENABLE_MOCK_PROVIDER=true

# Fresh Key - shared identity, project links and project-bound OAuth connectors
# Generate a long random value and NEVER commit production value.
FRESH_KEY_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARACTERS
FRESH_KEY_PUBLIC_ORIGIN=https://aiengine.freshcrackers.cz
FRESH_KEY_ALLOWED_RETURN_HOSTS=.freshcrackers.cz
# Odkazy do cílových aplikací pro potvrzení návrhu propojení
FRESH_KEY_LINDA_URL=https://socialmedia.freshcrackers.cz
FRESH_KEY_BOBAN_URL=https://webbooster.freshcrackers.cz
FRESH_KEY_EDA_URL=https://finance.freshcrackers.cz
FRESH_KEY_KAREL_URL=https://ai-coder.freshcrackers.cz

# Meta Developer App (one app can cover Facebook Pages + connected Instagram professional accounts)
FRESH_KEY_META_CLIENT_ID=
FRESH_KEY_META_CLIENT_SECRET=
FRESH_KEY_META_API_VERSION=v24.0
FRESH_KEY_META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# LinkedIn Developer App. Default scopes cover personal profile publishing.
# Organization/Page publishing additionally requires approved organization scopes.
FRESH_KEY_LINKEDIN_CLIENT_ID=
FRESH_KEY_LINKEDIN_CLIENT_SECRET=
FRESH_KEY_LINKEDIN_SCOPES=openid profile email w_member_social
FRESH_KEY_LINKEDIN_VERSION=202609

# Google Cloud OAuth client for Google Business Profile
FRESH_KEY_GOOGLE_CLIENT_ID=
FRESH_KEY_GOOGLE_CLIENT_SECRET=
FRESH_KEY_GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/business.manage
